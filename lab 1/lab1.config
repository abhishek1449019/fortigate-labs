# FortiGate 7.0.9 - Lab 1: LAN to Internet (Interface, Route, DNS, Policy + NAT)
# Paste into the FortiGate CLI console in GNS3

config system global
    set hostname "FGT-LAB1"
end

# WAN and LAN interfaces
config system interface
    edit "port1"
        set alias "WAN"
        set role wan
        set mode static
        set ip 192.168.118.10 255.255.255.0
        set allowaccess ping https ssh
    next
    edit "port2"
        set alias "LAN"
        set role lan
        set mode static
        set ip 192.168.10.1 255.255.255.0
        set allowaccess ping https ssh
    next
end

# Default route toward the GNS3 Cloud/NAT gateway
config router static
    edit 1
        set gateway 192.168.118.2
        set device "port1"
    next
end

# DNS used by the FortiGate itself
config system dns
    set primary 8.8.8.8
    set secondary 1.1.1.1
end

# LAN -> WAN policy with source NAT
config firewall policy
    edit 1
        set name "LAN-to-WAN"
        set srcintf "port2"
        set dstintf "port1"
        set srcaddr "all"
        set dstaddr "all"
        set action accept
        set schedule "always"
        set service "ALL"
        set nat enable
        set logtraffic all
    next
end
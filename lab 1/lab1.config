

config system interface
    edit "port1"
        set alias "WAN"
        set role wan
        set mode static
        set ip 192.168.118.10 255.255.255.0
        set allowaccess ping https ssh
    next
    edit "port2"
        set alias "LAN"
        set role lan
        set mode static
        set ip 192.168.1.1 255.255.255.0
        set allowaccess ping https
    next
end

config system dns
    set primary 8.8.8.8
    set secondary 1.1.1.1
end

config router static
    edit 1
        set gateway 192.168.118.2
        set device "port1"
    next
end

config system dhcp server
    edit 1
        set interface "port2"
        set default-gateway 192.168.1.1
        set netmask 255.255.255.0
        config ip-range
            edit 1
                set start-ip 192.168.1.100
                set end-ip 192.168.1.200
            next
        end
    next
end

config firewall policy
    edit 1
        set name "LAN-to-Internet"
        set srcintf "port2"
        set dstintf "port1"
        set srcaddr "all"
        set dstaddr "all"
        set action accept
        set schedule "always"
        set service "ALL"
        set nat enable
        set logtraffic all
    next
end